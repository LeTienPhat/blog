<div id="<%= dom_id post %>">
  <div>
    <strong>Title:</strong>
    <%= post.title %>
  </div>

  <div>
    <strong>Body:</strong>
    <%= post.body %>
  </div>

  <div>
    <strong>Author Type:</strong>
    <%= post.authorable_type %>
  </div>

  <div>
    <strong>Author Email:</strong>
    <%= post.authorable.email %>
  </div>

  <p>
    <strong>Created at:</strong>
    <%= post.created_at %>
  </p>
</div>
