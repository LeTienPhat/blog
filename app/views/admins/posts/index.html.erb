<div class="container mt-4">
  <% if notice %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <% content_for :title, "Posts" %>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Posts</h1>
    <%= link_to "New post", new_admins_post_path, class: "btn btn-primary text-white" %>
  </div>

  <%= simple_form_for :search, url: admins_posts_path, method: :get, html: { class: "mb-4" } do |f| %>
    <div class="input-group">
      <%= f.text_field :title, placeholder: "Search posts...", class: "form-control" %>
      <button class="btn btn-outline-secondary" type="submit">Search</button>
      <%= link_to "Clear", admins_posts_path, class: "btn btn-outline-secondary" %>
    </div>
  <% end %>

  <div class="table-responsive">
    <table id="posts" class="table table-striped table-hover">
      <thead class="table-dark">
        <tr>
          <th scope="col">#</th>
          <th scope="col">Title</th>
          <th scope="col">Created At</th>
          <th scope="col">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @posts.each do |post| %>
          <tr>
            <th scope="row"><%= post.id %></th>
            <td><%= link_to post.title, admins_post_path(post), class: "text-decoration-none" %></td>
            <td><%= post.created_at.strftime("%B %d, %Y") %></td>
            <td>
              <%= link_to "Show", admins_post_path(post), class: "btn btn-sm btn-info me-1 text-white" %>
              <%= link_to "Edit", edit_admins_post_path(post), class: "btn btn-sm btn-warning me-1 text-dark" %>
              <%= link_to "Delete", admins_post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger text-white" %>
            </td>
          </tr>
        <% end %>

        <% if @posts.empty? %>
          <tr>
            <td colspan="4" class="text-center text-muted">No posts found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @posts %>
</div>
