<div class="container mt-4">
  <% content_for :title, "New Post" %>

  <div class="row justify-content-center">
    <div class="col-md-8">
      <div class="card">
        <div class="card-header">
          <h1 class="h4 mb-0">Create New Post</h1>
        </div>
        <div class="card-body">
          <%= render "form", url: users_posts_path, post: @post %>
        </div>
        <div class="card-footer">
          <%= link_to "Back to posts", users_posts_path, class: "btn btn-secondary text-white" %>
        </div>
      </div>
    </div>
  </div>
</div>
