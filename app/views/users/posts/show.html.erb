<p style="color: green"><%= notice %></p>

<%= render @post %>

<div>
  <%= link_to "Edit this post", edit_users_post_path(@post) %> |
  <%= link_to "Back to posts", users_posts_path %>
  <%= button_to "Destroy this post", users_post_path(@post), method: :delete, class: "btn btn-warning mt-2" %>
</div>

<%= render "users/comments/comments", post: @post %>
